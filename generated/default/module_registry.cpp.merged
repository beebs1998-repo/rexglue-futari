#include <rex/system/kernel_state.h>

void RegisterRecompiledModules(rex::system::KernelState* kernel_state) {

  kernel_state->RegisterRecompiledModule(
      "palm_normal.xex",
      "media/module/palm_normal.xex",
      "futari_palm_normal");

  kernel_state->RegisterRecompiledModule(
      "palm_abnormal.xex",
      "media/module/palm_abnormal.xex",
      "futari_palm_abnormal");

  kernel_state->RegisterRecompiledModule(
      "hirow_normal.xex",
      "media/module/hirow_normal.xex",
      "futari_hirow_normal");

  kernel_state->RegisterRecompiledModule(
      "hirow_abnormal.xex",
      "media/module/hirow_abnormal.xex",
      "futari_hirow_abnormal");

  kernel_state->RegisterRecompiledModule(
      "kiniro_normal.xex",
      "media/module/kiniro_normal.xex",
      "futari_kiniro_normal");

  kernel_state->RegisterRecompiledModule(
      "kiniro_abnormal.xex",
      "media/module/kiniro_abnormal.xex",
      "futari_kiniro_abnormal");

  kernel_state->RegisterRecompiledModule(
      "reco_normal.xex",
      "media/module/reco_normal.xex",
      "futari_reco_normal");

  kernel_state->RegisterRecompiledModule(
      "reco_abnormal.xex",
      "media/module/reco_abnormal.xex",
      "futari_reco_abnormal");

}
